// Catppuccin Frappe

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/logo/IMG_5468.PNG",
    "width": 32,
    "height": 14,
    "padding": {
      "top": 1,
      "left": 0,
      "right": 2
    }
  },
  "display": {
    "separator": " \u001b[38;2;202;158;230m\u001b[0m ",
    "constants": [
      "\u001b[38;2;238;190;190m─────\u001b[0m" // {$1}, used in Custom module
    ],
    "key": {
      "type": "icon",
      "paddingLeft": 2
    }
  },
  "modules": [
    {
      "type": "custom", // HardwareStart
      // {#1} is equivalent to `\u001b[1m`. {#} is equivalent to `\u001b[m`
      "format": "\u001b[38;2;238;190;190m┌\u001b[0m{$1} \u001b[38;2;202;158;230mHardware Information\u001b[0m {$1}\u001b[38;2;238;190;190m┐\u001b[0m"
    },
    {
      "type": "host",
      "keyColor": "#f4b8e4",
      "format": "{1}"
    },
    {
      "type": "cpu",
      "keyColor": "#f4b8e4",
      "format": "{1}"
    },
    {
      "type": "disk",
      "format": "{1} / {2}",
      "keyColor": "#f4b8e4"
    },
    {
      "type": "memory",
      "format": "{1} / {2}",
      "keyColor": "#f4b8e4"
    },
    {
      "type": "display",
      "format": "{1}x{2} in {12}\", {3} Hz",
      "keyColor": "#f4b8e4"
    },
    {
      "type": "custom", // InformationEnd
      "format": "\u001b[38;2;238;190;190m└\u001b[0m{$1}\u001b[38;2;238;190;190m──────────────────────\u001b[0m{$1}\u001b[38;2;238;190;190m┘\u001b[0m"
    },
    {
      "type": "custom", // Separator
      "format": ""
    },
    {
      "type": "custom", // SoftwareStart
      "format": "\u001b[38;2;238;190;190m┌\u001b[0m{$1} \u001b[38;2;202;158;230mSoftware Information\u001b[0m {$1}\u001b[38;2;238;190;190m┐\u001b[0m"
    },
    {
      "type": "os",
      "keyColor": "#f4b8e4"
    },
    {
      "type": "kernel",
      "keyColor": "#f4b8e4"
    },
    {
      "type": "wm",
      "keyColor": "#f4b8e4"
    },
    {
      "type": "terminal",
      "keyColor": "#f4b8e4"
    },
    {
      "type": "uptime",
      "keyColor": "#f4b8e4"
    },
    {
      "type": "custom", // InformationEnd
      "format": "\u001b[38;2;238;190;190m└\u001b[0m{$1}\u001b[38;2;238;190;190m──────────────────────\u001b[0m{$1}\u001b[38;2;238;190;190m┘\u001b[0m"
    },
  ]
}
